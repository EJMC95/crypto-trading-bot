# Image for 🧙 The Wizard (book-schwager-shadow) — the CUT-LOSSES-RIDE-
# WINNERS BOOK, shadow only. Set the service variables:
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.schwager
#   VENUE=lighter_shadow
# The bot REFUSES every other VENUE (loud SystemExit): a $1,000 paper book
# riding 4h Donchian-20 breakouts with a wide 3.5xATR chandelier trail and
# NO pyramid (Market Wizards' consensus rules, the pyramid measured and
# refuted), fills modelled at mark, ZERO keys. Config is ENV-ONLY (no tuning
# lane), single-policy (hm) clock by construction.
#
# COPY set is the kiyosaki one minus funding_basis (a price book never
# touches a funding rate). fleet_bus IS a guarded import (universe + crypto
# screen) and ships in the SAME commit as the import (born-dark rule).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY lighter_book_schwager_bot.py bot_pnl_store.py paper_broker.py fleet_bus.py ./
COPY venues/ ./venues/

ENV PYTHONUNBUFFERED=1

CMD ["python", "lighter_book_schwager_bot.py"]
