# ---------------------------------------------------------------------------
# Credentials. NEVER commit real values. NEVER log them. The logging handler
# redacts secrets below every call site, but the first defence is that these
# live only in the environment.
#
# The system does not need any of these to BACKTEST or to PAPER trade.
# ---------------------------------------------------------------------------
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
EXCHANGE_SUBACCOUNT=

# ---------------------------------------------------------------------------
# Live gating. BOTH are required, and `live` ALSO asks interactively.
# Leaving either unset is what keeps the system in a non-submitting mode.
# ---------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
LIVE_CONFIRMATION=

# Required by `flatten`, separately and on purpose.
FLATTEN_CONFIRMATION=

# Override the 30-day paper soak. Documented, deliberate, and it still needs
# both confirmations above plus the interactive one.
PAPER_SOAK_OVERRIDE=
