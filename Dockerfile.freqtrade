# Freqtrade image for Railway — runs all 4 dry-run bots in one container.
# Build target for the Railway service (set Dockerfile path = Dockerfile.freqtrade).
FROM freqtradeorg/freqtrade:stable

USER root
# psycopg2 for the P&L poller that publishes to the shared Postgres table.
RUN pip install --no-cache-dir psycopg2-binary
# Bake in the bot configs + strategies (built locally in user_data/)
COPY user_data /freqtrade/user_data
COPY run_all.sh /freqtrade/run_all.sh
COPY dashboard_server.py /freqtrade/dashboard_server.py
COPY bot_pnl_store.py /freqtrade/bot_pnl_store.py
# fleet_bus: strategies' read-side client for brain stake-mults + fleet-risk veto
COPY fleet_bus.py /freqtrade/fleet_bus.py
COPY freqtrade_pnl_poller.py /freqtrade/freqtrade_pnl_poller.py
COPY market_pulse.py /freqtrade/market_pulse.py
COPY bot_learn.py /freqtrade/bot_learn.py
COPY regime_oracle.py /freqtrade/regime_oracle.py
COPY fleet_risk.py /freqtrade/fleet_risk.py
COPY cleanup_legacy_bots.py /freqtrade/cleanup_legacy_bots.py
RUN chmod +x /freqtrade/run_all.sh && chown -R ftuser:ftuser /freqtrade/user_data /freqtrade/run_all.sh /freqtrade/dashboard_server.py /freqtrade/bot_pnl_store.py /freqtrade/freqtrade_pnl_poller.py /freqtrade/market_pulse.py
# Persistent DB dir for the freqtrade sqlite files. Mount a Railway VOLUME at
# /freqtrade/persist so open paper trades survive redeploys; without a volume
# it still works (ephemeral). Created + owned by ftuser so freqtrade can write.
RUN mkdir -p /freqtrade/persist && chown ftuser:ftuser /freqtrade/persist
USER ftuser

WORKDIR /freqtrade
# Clear freqtrade's default entrypoint so our supervisor script runs instead.
ENTRYPOINT []
CMD ["sh", "/freqtrade/run_all.sh"]
