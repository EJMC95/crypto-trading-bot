# Freqtrade image for Railway — runs all 4 dry-run bots in one container.
# Build target for the Railway service (set Dockerfile path = Dockerfile.freqtrade).
FROM freqtradeorg/freqtrade:stable

USER root
# [2026-07-15 AUDIT FIX] make /freqtrade importable from strategy callbacks —
# fleet_bus/bot_pnl_store live there, but freqtrade runs with user_data on
# sys.path, so `import fleet_bus` silently failed (fail-safe try/except) and
# the L2 veto / L4 stake-mults never executed in this container.
ENV PYTHONPATH=/freqtrade
# psycopg2 for the P&L poller that publishes to the shared Postgres table.
# [2026-07-17 INCIDENT — BORN-DARK, ONE LAYER DOWN] lighter-sdk + websockets are
# NOT optional here: the Ticket Taker's DEFAULT mode (TT_VENUE=lighter_shadow)
# constructs venues.lighter_client.LighterClient, which does `import lighter`.
# This image had never installed it, so from the moment the shadow arm shipped
# (c5924e4, 05:35 UTC) the taker CRASH-LOOPED every 5 min:
#     venues.base.VenueError: lighter-sdk missing ... No module named 'lighter'
# MEASURED: the -lshadow row last published 05:48 UTC and then went stale for
# ~1h, and venue_orders for this bot is still ZERO — the arm that exists to
# earn a go-live had never completed a single cycle. c5924e4's "shadow arm
# healthy (1013.99, 18 closes)" and 09245dd's repeat of it were both reading
# the LAST publish of the OLD image: a fossil, not a heartbeat.
# WHY THE GUARD MISSED IT: audit_image_imports models REPO-LOCAL imports — it
# caught the missing `COPY venues/` and was satisfied. `lighter` is a PIP dep,
# invisible to it, so the guard verified the file and not the wheel. Same
# failure class, one layer down. See BORN_DARK_OK / the 17-Jul (m) CHANGELOG.
# [2026-07-17] lighter-sdk PINNED — see requirements.txt for the full reason.
# This image names the dep by hand instead of using requirements.txt, so the
# `>=` drift had to be closed in BOTH places or the pin is decorative. 1.1.2 is
# the version the live fleet is MEASURED to run (boot banner, 17-Jul 10:58Z).
RUN pip install --no-cache-dir psycopg2-binary "lighter-sdk==1.1.2" "websockets>=12.0.0"
# Bake in the bot configs + strategies (built locally in user_data/)
COPY user_data /freqtrade/user_data
COPY run_all.sh /freqtrade/run_all.sh
COPY dashboard_server.py /freqtrade/dashboard_server.py
COPY bot_pnl_store.py /freqtrade/bot_pnl_store.py
# [2026-07-17] the fleet's funding-BASIS authority (Lighter quotes an 8h
# rate; annualising it hourly was 8x). Imported by lighter_market_scout.
COPY funding_basis.py /freqtrade/funding_basis.py
# fleet_bus: strategies' read-side client for brain stake-mults + fleet-risk veto
COPY fleet_bus.py /freqtrade/fleet_bus.py
COPY freqtrade_pnl_poller.py /freqtrade/freqtrade_pnl_poller.py
COPY market_pulse.py /freqtrade/market_pulse.py
COPY bot_learn.py /freqtrade/bot_learn.py
# [2026-07-17] brain_stats was NEVER COPY'd — the v3 statistics engine
# (decay, EB pooling, Wilson bars, episode grading) silently fell back to
# frozen v2 in production from the day it "shipped": import-guarded
# fallbacks hid it (the None episode fields in brain-lens-forward were the
# tell; bot_learn now also logs the fallback loudly). Same class as the
# event_sentinel born-dark COPY above — a systematic import-vs-COPY audit
# now guards this (see CHANGELOG 17-Jul).
COPY brain_stats.py /freqtrade/brain_stats.py
COPY regime_oracle.py /freqtrade/regime_oracle.py
COPY fleet_risk.py /freqtrade/fleet_risk.py
COPY cleanup_legacy_bots.py /freqtrade/cleanup_legacy_bots.py
COPY lighter_market_scout.py /freqtrade/lighter_market_scout.py
COPY paper_broker.py /freqtrade/paper_broker.py
COPY lighter_ticket_taker.py /freqtrade/lighter_ticket_taker.py
# [2026-07-17] venues/ — the taker's LIVE PATH. It was PaperBroker-only
# (modelled fills, flat 4bps); it now defaults to ShadowBroker, which walks the
# REAL Lighter book and writes decision-vs-fill slippage to venue_orders. That
# import is LAZY (inside the mode branch), so without this COPY the taker would
# have crash-looped on its DEFAULT mode in production, silently, exactly like
# brain_stats/event_sentinel/fleet_bus did this week. Caught by
# scripts/audit_image_imports.py before shipping, which is the whole point.
COPY venues/ /freqtrade/venues/
COPY evidence_board.py /freqtrade/evidence_board.py
# fleet_tuning: the bounded growth rail (board + scout tuner = authors)
COPY fleet_tuning.py /freqtrade/fleet_tuning.py
# [2026-07-21] the organs' proposal channel to the tuners (operator mandate);
# consumed by scout tuner / judge, written by sentinel / shortfall / respiration
COPY fleet_proposals.py /freqtrade/fleet_proposals.py
# the Lighter loop's replay harness + self-tuning organ (scout tape ->
# taker's real code -> bounded lever enactments)
COPY lighter_ticket_replay.py /freqtrade/lighter_ticket_replay.py
COPY lighter_scout_tuner.py /freqtrade/lighter_scout_tuner.py
# proprioception: grades every growth-rail enactment episode out-of-sample;
# the scout tuner consumes its HURTING verdicts (restrict-only)
COPY fleet_proprioception.py /freqtrade/fleet_proprioception.py
# the shadow→live promotion judge (paired arms, both-halves, fade-watch)
COPY experiment_judge.py /freqtrade/experiment_judge.py
# the immune + self-repair organ (alert filtration, sickness detection,
# lever quarantine) — fleet_tuning.get_lever honors its quarantines
COPY fleet_immune.py /freqtrade/fleet_immune.py
# [2026-07-17] the event organ (RSS+GDELT major-event scanner + sector
# playbook). Shipped 16-Jul into run_all.sh but never COPY'd — the loop's
# `|| true` swallowed "No such file" every 10 min and the organ sat DARK
# since birth. The infra flavour of enacted-is-not-applied.
COPY event_sentinel.py /freqtrade/event_sentinel.py
# circadian clock, regeneration (last-good restore), reproduction (genotype
# breeding), respiration (blood-oxygen / hypoxia monitor)
COPY fleet_clock.py /freqtrade/fleet_clock.py
COPY fleet_regen.py /freqtrade/fleet_regen.py
COPY strategy_incubator.py /freqtrade/strategy_incubator.py
COPY fleet_respiration.py /freqtrade/fleet_respiration.py
# live-vs-shadow execution-quality tracker (implementation shortfall)
COPY implementation_shortfall.py /freqtrade/implementation_shortfall.py
# [2026-07-23] 📡 the edge RADAR — grades every LIVING book by significance +
# both-halves + median/jackknife robustness + an ETA to verdict, so feed/park/
# cull writes itself. Imports bot_pnl_store + cleanup_legacy_bots (both COPY'd);
# audit_image_imports verifies. Publish-only, --publish gated.
COPY fleet_radar.py /freqtrade/fleet_radar.py
# [2026-08-01 (hv)] the allocation organ — publish-only; see fleet_allocation.py
COPY fleet_allocation.py /freqtrade/fleet_allocation.py
# [2026-07-30] 🚦 the GO-LIVE GRADER becomes an organ. It implements the (fk)
# bar — the ONE rule that decides whether a shadow book may ever hold real
# money — and until now it shipped in no image and ran on no schedule, so its
# verdicts existed only when a human remembered to type the command. Kept at
# its repo path (`scripts/`) because the module inserts its parent on sys.path
# to import bot_pnl_store / experiment_judge / cleanup_legacy_bots (all COPY'd
# above); moving it to /freqtrade would silently insert `/` instead.
# Publish-only and --publish gated, exactly like the radar: it grades, it
# promotes nothing, and go-live stays an explicit operator act.
COPY scripts/golive_readiness.py /freqtrade/scripts/golive_readiness.py
# [2026-08-27 (vm)] THE WIN SIDE GETS A SCHEDULE, AND ITS CLAIMS GET AN OWNER.
# Same reasoning as the grader directly above, and the same (gk) failure it was
# built to end: `winners_docket.py` — the fleet's ONLY instrument that can say
# "this bucket is winning, provably" (I21) — has existed since 18-Aug in NO
# image and NO loop, so it ran only when a human typed it. `claims_ledger.py`
# is its record: every number the fleet has committed to, each naming an organ
# field that can recompute it, so a figure quoted in doctrine reddens a build
# when it drifts instead of standing stale for days. WITHOUT THESE TWO LINES
# both run_all.sh loops are no-ops behind `|| true` — `audit_claim_freshness`
# fails on exactly that and prints these lines verbatim.
COPY scripts/winners_docket.py /freqtrade/scripts/winners_docket.py
COPY scripts/claims_ledger.py /freqtrade/scripts/claims_ledger.py
COPY lighter_book_bezos_bot.py /freqtrade/lighter_book_bezos_bot.py
# [2026-09-01 (vw)] 🚀 bezos is a WRAPPER around the Douglas engine, and PR
# #238 shipped the wrapper without the engine — audit_image_imports flagged it
# the day it merged (rc=1) and the merge went through anyway, so the bot died
# on this import every 30s for two days: born dark, the exact class the guard
# exists for. The engine module rides along; its own service keeps its own
# image (Dockerfile.douglas) — this copy only feeds the wrapper.
COPY lighter_book_douglas_bot.py /freqtrade/lighter_book_douglas_bot.py
# [2026-07-21] 🏛️ the Parliament — the six-layer PM shadow fleet (six $1k
# books + scanners + ML + tuners + brain), launched from run_all.sh. Imports
# bot_pnl_store / fleet_bus / funding_basis / paper_broker — all COPY'd above
# (audit_image_imports verifies; that guard exists because of three born-dark
# incidents in this exact image).
COPY parliament/ /freqtrade/parliament/
COPY parliament_main.py /freqtrade/parliament_main.py
RUN chmod +x /freqtrade/run_all.sh && chown -R ftuser:ftuser /freqtrade/user_data /freqtrade/run_all.sh /freqtrade/dashboard_server.py /freqtrade/bot_pnl_store.py /freqtrade/freqtrade_pnl_poller.py /freqtrade/market_pulse.py
# Persistent DB dir for the freqtrade sqlite files. Mount a Railway VOLUME at
# /freqtrade/persist so open paper trades survive redeploys; without a volume
# it still works (ephemeral). Created + owned by ftuser so freqtrade can write.
RUN mkdir -p /freqtrade/persist && chown ftuser:ftuser /freqtrade/persist
USER ftuser

WORKDIR /freqtrade
# Clear freqtrade's default entrypoint so our supervisor script runs instead.
ENTRYPOINT []
CMD ["sh", "/freqtrade/run_all.sh"]
