# Image for 🧘 The Zone (book-douglas-shadow) — the DISCIPLINE BOOK, shadow
# only. Set the service variables:
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.douglas
#   VENUE=lighter_shadow
# The bot REFUSES every other VENUE (loud SystemExit): a $1,000 paper book
# fading extreme 1h impulses with a bracket predefined at entry (Trading in
# the Zone's execution doctrine as code), fills modelled at mark, ZERO keys.
# Config is ENV-ONLY (no tuning lane), single-policy (hm) clock by
# construction.
#
# COPY set is the kiyosaki one minus funding_basis (a price book never
# touches a funding rate; a dead file in the image is a lie about the
# import graph). fleet_bus IS a guarded import (universe + crypto screen)
# and ships in the SAME commit as the import (born-dark rule).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY lighter_book_douglas_bot.py bot_pnl_store.py paper_broker.py fleet_bus.py ./
COPY venues/ ./venues/

ENV PYTHONUNBUFFERED=1

CMD ["python", "lighter_book_douglas_bot.py"]
