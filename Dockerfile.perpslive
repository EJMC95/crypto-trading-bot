# Image for the bounce-catcher-live Railway service (Bounce Catcher on Lighter).
# Set RAILWAY_DOCKERFILE_PATH=Dockerfile.perpslive on that service.
#
# SAFETY: inert until the user supplies LIGHTER_API_PRIVATE_KEY and explicitly
# sets REAL_MONEY_KILL=DISARMED_I_UNDERSTAND. With VENUE=lighter_live and the
# kill switch armed (default), boot REFUSES (venues/safety.py).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY hyperliquid_perps_bot.py bot_pnl_store.py paper_broker.py ./
COPY venues/ ./venues/

ENV PYTHONUNBUFFERED=1

CMD ["python", "hyperliquid_perps_bot.py"]
