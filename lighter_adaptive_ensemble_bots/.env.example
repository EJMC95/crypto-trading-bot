# ---------------------------------------------------------------------------
# Lighter credentials. NEVER commit real values; never log them.
# The API key is tied to an ACCOUNT INDEX and each key carries its own nonce.
# Use a dedicated bot key, not a wallet key with broader permissions.
# ---------------------------------------------------------------------------
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_CHAIN_ID=304
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Live gating. All three are required, and `live` ALSO asks interactively.
# Leaving any of them unset is what keeps the system in a non-signing mode.
# ---------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
LIVE_CONFIRMATION=
FLATTEN_CONFIRMATION=

# Override the 30-day / 100-signal paper+shadow soak requirement. Documented,
# deliberate, and it still needs both confirmations above.
LIVE_SOAK_OVERRIDE=

# Optional: where runtime state and the kill switch live.
LIGHTER_BOTS_STATE_DIR=state
LIGHTER_BOTS_RUNTIME_DIR=runtime
