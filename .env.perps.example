# Hyperliquid TESTNET credentials — copy this file to .env.perps and fill in.
# NEVER commit .env.perps or share these values. Testnet wallets can still be drained.

# Private key of the API wallet you generated under Hyperliquid -> More -> API (testnet).
HL_API_PRIVATE_KEY=0xyour_testnet_api_wallet_private_key_here

# Your main account address (the wallet that holds the testnet USDC).
# Needed when the API wallet differs from the funded account.
HL_ACCOUNT_ADDRESS=0xyour_account_address_here

# Optional: Zapier "Catch Hook" webhook URL. When set, the bot POSTs every trade
# event (open/exit/stop) here, and your Zap forwards it to Slack. Leave blank to
# disable alerts. Works in --paper mode too, so you can test Slack with no money.
ZAPIER_WEBHOOK_URL=
