# Image for 🏆 Stock Leaders (the Alpaca momentum bot on Lighter STOCK PERPS)
# — SHADOW ONLY in v1. Set the service variables:
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.momoshadow
#   VENUE=lighter_shadow
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Rule verbatim from ~/Claude/Trading/bot/strategy.py (qualify close>SMA200 &
# SMA20>SMA50, rank by 42d return, hold top-5); weekly rebalance per the
# 13-Jul variant grid; 20-name probed universe. REFUSES lighter_live in v1;
# the Alpaca paper account is the control arm. No keys needed for shadow.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY lighter_momentum_bot.py bot_pnl_store.py paper_broker.py funding_basis.py ./
COPY venues/ ./venues/

# [2026-07-13 SHELL REUSE] Stock Leaders deployed into the vacant perps-bot
# service (user-approved; Funding Farmer/trail-blazer-live precedent) while
# the railway CLI's service-creation auth is expired. That shell carries the
# OLD custom start command `python hyperliquid_perps_bot.py`, which overrides
# this CMD — the symlink satisfies it so the momentum bot runs either way.
# Remove the start-command override in the service UI (or move to a clean
# service) and this shim becomes inert.
RUN ln -s lighter_momentum_bot.py hyperliquid_perps_bot.py

ENV PYTHONUNBUFFERED=1

CMD ["python", "lighter_momentum_bot.py"]
