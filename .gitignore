*.sqlite-shm
*.sqlite-wal
*.sqlite-*
scripts/.tape_cache/
scripts/.funding_cache.json
scripts/.dirfund_cache.json
scripts/.tiderider_perp_cache.json

# ---- Backtest caches (scripts/ hidden json = offline-rerun caches, ~10MB) ----
# NOTE: .claude/settings.local.json stays TRACKED on purpose (15-Jul #55/#56:
# it mirrors the claude-code-remote allowlist to every checkout).
scripts/.*.json
# [2026-08-20 (sc)] and the PICKLE ones — the wildcard above is .json only,
# so a .pkl tape cache (nav-cook's is 58MB) sailed past it into `git add`.
scripts/.*.pkl

# test artifacts
.coverage
# [2026-07-30 (gp)] coverage.json is a BUILD ARTIFACT. CI generates it
# (tests.yml: `coverage json -o coverage.json`) and passes it to
# audit_coverage_floors.py explicitly. A committed one is junk at best:
# I committed a 1-module, 10.6% run by accident via `git add -A`, and a
# local audit run would then grade the real-money floors against it.
coverage.json
.pytest_cache/
htmlcov/
__pycache__/

# machine-local Claude permission list — it stores commands VERBATIM, so any
# command containing a secret becomes a stored secret. Untracked 2026-07-22
# after a live DB password accumulated into it (see CHANGELOG cc).
.claude/settings.local.json
scripts/.books_cohort_cache/
scripts/.band_kelly_cache/
scripts/.divstudy_cache/
scripts/.sqz_cache/
scripts/.ladder_cache/
scripts/.band_kelly_horizon_cache/
scripts/.ext_veto_cache/

# [(aan)] study tape caches — a registered selftest module writes megabytes
# of venue candles beside itself; untracked and unignored is one `git add -A`
# away from being committed.
scripts/.*_tape*/
