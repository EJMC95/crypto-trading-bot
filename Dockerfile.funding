# Image for the perps-funding-carry Railway service.
# Set the service variable RAILWAY_DOCKERFILE_PATH=Dockerfile.funding — the CMD
# is baked in here so the service needs no dashboard Start Command.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# [2026-07-09 LIGHTER GATE-0] funding_carry_bot now imports the venues/ layer
# (+ paper_broker for the hl_paper path); copy them or the image ImportErrors.
# [2026-07-17] + funding_basis: the per-venue basis authority. funding_carry_bot
# grew a lighter_shadow arm and was annualising Lighter's 8h quote as hourly
# (the sixth 8x bot). The import is BARE, so a missing COPY crash-loops this
# service on boot — caught at author time by scripts/audit_image_imports.py,
# which is the 6th time that guard has stopped a born-dark ship.
COPY funding_carry_bot.py bot_pnl_store.py paper_broker.py funding_basis.py ./
COPY venues/ ./venues/

ENV PYTHONUNBUFFERED=1

CMD ["python", "funding_carry_bot.py"]
