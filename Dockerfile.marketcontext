# Image for 🛰️ market-context (fleet instrumentation collector).
# Set RAILWAY_DOCKERFILE_PATH=Dockerfile.marketcontext. INSTRUMENT-ONLY: this
# service never trades — it collects OI / funding dispersion / liquidation-tape
# / heat into bot_state("market-context") + a per-coin quality table, which the
# trading bots attach to their entry ledger rows for later validation.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# [2026-07-17 VENUE SWAP] The collector now reads LIGHTER natively, so it needs
# funding_basis.py (the 8h-vs-hourly funding authority) and venues.symbol_map's
# from_lighter (fleet <-> Lighter symbol namespace). Both are SINGLE-AUTHORITY
# modules — inlining either is how the 8x funding bug happened (a constant
# ported by hand, then drifting silently). See funding_basis.py's header.
#
# `COPY venues/` matches the 8 other Lighter images. It brings the package's
# inert class definitions along for a service that never trades; the two
# modules that are deliberately NOT copied (fleet_tuning, paper_broker) are
# DECLARED in scripts/audit_image_imports.py BORN_DARK_OK with reasons —
# silence is not an option (CLAUDE.md born-dark rule).
# [2026-07-17] cleanup_legacy_bots.py is the fleet's ONE authority on which
# rows are retired, and market_context's selftest asserts LIVE_CADENCE_SEC
# against it (the rot guard evidence_board.py and fleet_proprioception.py
# already carry — Dockerfile.freqtrade:55 copies it for exactly that reason).
# Stdlib-only, 164 lines, no cascade. COPY'd rather than declared BORN_DARK_OK
# so `--selftest` is runnable INSIDE this image: a guard that can only run on
# someone's laptop is the control that already failed here once — this dict
# rotted because retiring a row and sweeping the rosters were separate acts
# nobody linked.
COPY market_context.py bot_pnl_store.py funding_basis.py cleanup_legacy_bots.py ./
COPY venues/ ./venues/

ENV PYTHONUNBUFFERED=1

CMD ["python", "market_context.py"]
