# Image for the LIVE 🎫 Ticket Taker (lighter-ticket-taker -> row
# lighter-ticket-taker-lighter). Point the service's Railway Config File at
# railway.takerlive.toml (which selects this Dockerfile).
#
# THE LIVE ARM NEEDS ITS OWN SERVICE — it cannot ride freqtrade-bots.
#   That container hosts the SHADOW arm plus ~19 other processes. Setting
#   TT_VENUE=lighter_live there would convert the shadow book itself — killing
#   the control arm and the only evidence a go-live rests on — and
#   REAL_MONEY_KILL is read from the process env, so disarming it there would
#   disarm it for everything in the container. Separate service, separate env,
#   separate blast radius.
#
# INERT BY CONSTRUCTION. This image trades NOTHING until an operator sets, on
# the service:
#   TT_VENUE=lighter_live                  (mandatory — the bot refuses without
#                                           it; identity is never inherited)
#   REAL_MONEY_KILL=DISARMED_I_UNDERSTAND  (defaults to ARMED in venues/safety)
#   LIGHTER_TICKET_TAKER_MAX_NOTIONAL=<$>  (live refuses to boot with no cap)
#   LIGHTER_API_PRIVATE_KEY / LIGHTER_ACCOUNT_INDEX   (operator's, never here)
# Every one of those is the operator's to set. None is baked in, and none has a
# default that trades. See GO_LIVE_LIGHTER.md for the runbook.
FROM python:3.11-slim
WORKDIR /app

# requirements.txt carries lighter-sdk (the signer) + websockets. UNGUARDED
# need: the live path constructs LighterClient, whose `import lighter` is what
# crash-looped the shadow arm for an hour on 17-Jul when freqtrade-bots lacked
# the wheel. The born-dark guard models repo-local imports and cannot see a
# missing pip dep — so this line is load-bearing and deliberate.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The taker's real import set, verified by AST walk (not by eye):
#   bot_pnl_store  funding_basis  paper_broker  fleet_tuning
#   venues.{safety,symbol_map,lighter_client,shadow}
# funding_basis + venues.safety + venues.symbol_map are UNGUARDED module-scope
# imports on the real-money path — a missing one is a crash, not a degrade.
# paper_broker is required transitively (venues/shadow.py subclasses it).
COPY lighter_ticket_taker.py bot_pnl_store.py funding_basis.py paper_broker.py fleet_tuning.py ./
COPY venues/ ./venues/
COPY taker_live_entry.sh ./
RUN chmod +x taker_live_entry.sh

ENV PYTHONUNBUFFERED=1
CMD ["./taker_live_entry.sh"]
