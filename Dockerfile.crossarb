# Cross-exchange-arb image for Railway — runs the depth-aware paper-trading
# scanner 24/7 in the cloud. Select per-service via the RAILWAY_DOCKERFILE_PATH
# variable = Dockerfile.crossarb (so this service builds this image, not the
# generic root Dockerfile).
FROM python:3.11-slim

WORKDIR /app
# ccxt = public market data (Kraken/Coinbase Exchange/Gemini); psycopg2 =
# publish P&L to the shared Postgres table so it shows on the unified dashboard.
RUN pip install --no-cache-dir "ccxt>=4.2.0" "psycopg2-binary>=2.9"

COPY cross_exchange_arb.py /app/cross_exchange_arb.py
COPY bot_pnl_store.py /app/bot_pnl_store.py
# fleet_tuning: the evidence board's bounded growth rail (scanner = consumer)
COPY fleet_tuning.py /app/fleet_tuning.py

ENV PYTHONUNBUFFERED=1
# Detection + paper trading only. NO API keys, places NO real orders.
# Set DATABASE_URL (reference the Postgres service) so it publishes to the
# unified dashboard; without it, store.publish is a guarded no-op.
CMD ["python", "cross_exchange_arb.py"]
